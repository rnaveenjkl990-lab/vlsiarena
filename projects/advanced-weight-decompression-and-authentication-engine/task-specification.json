        "updates": [
          {
            "id": "U2",
            "transitionIds": [
              "F2"
            ],
            "operation": "set",
            "value": "mac_accumulator ^ weight_data"
          },
          {
            "id": "U3",
            "transitionIds": [
              "F4",
              "F5"
            ],
            "operation": "set",
            "value": 0
          }
        ]
      }
    ],
    "datapathRules": [
