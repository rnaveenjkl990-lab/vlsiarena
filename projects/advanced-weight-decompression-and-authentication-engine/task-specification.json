        "sampling": "pos_edge",
        "timing": "T1"
      }
    ],
    "parameters": [
      {
        "name": "TAG_WIDTH",
        "value": 16,
        "min": 8,
        "max": 32,
        "description": "Width of MAC tag and data channels"
      }
    ],
    "fixedConstants": [
      {
        "name": "MAX_FIFO_DEPTH",
        "value": 8,
        "width": 4,
        "signed": false,
        "description": "Maximum activation buffer slots"
      }
    ],
    "clock": {
      "signal": "clk",
      "edge": "posedge"
    },
    "reset": {
      "signal": "rst_n",
      "active": 0,
      "kind": "synchronous"
    },
    "description": "Decompresses incoming weight streams, computes a running MAC authentication code, manages cache line fill collisions, and streams valid activations into a buffer with sideband fault signaling.",
    "functionalOverview": "The DUT ingests compressed weight chunks and MAC tags, performs decompression via run-length arithmetic, evaluates authenticity, handles cache store collisions by stalling or aborting, and buffers verified activations.",
    "architecture": "Comprises an input ingest stage, an arithmetic decompression core, a lightweight MAC verification unit, a collision detection controller, and a 8-entry activation FIFO.",
    "microarchitecture": "Controlled by an explicit 4-state FSM (IDLE, COMPRESS, VERIFY, FAULT) coordinating datapath registers, tag comparison, and sideband alert generation.",
    "resetBehavior": "Synchronous active-low reset clears all FSM states, internal counters, FIFO pointers, and alert outputs to zero.",
    "behaviorRules": [
      {
        "id": "B1",
        "type": "protocol",
        "rule": "Input weights are accepted only when the FSM is in COMPRESS or IDLE and internal FIFO is not full."
      },
      {
        "id": "B2",
        "type": "error",
        "rule": "A cache line fill collision immediately asserts fault_alert and transitions the FSM to FAULT."
      },
      {
        "id": "B3",
        "type": "data",
        "rule": "Decompressed output is emitted only when verification succeeds and out_ready is asserted."
      }
    ],
    "controlModelKind": "fsm_datapath",
    "controlFsm": {
      "initialState": "IDLE",
      "states": [
        {
          "id": "IDLE",
          "description": "Waiting for weight or tag stream"
        },
        {
          "id": "COMPRESS",
          "description": "Decompressing and accumulating MAC"
        },
        {
          "id": "VERIFY",
          "description": "Validating computed MAC against expected tag"
        },
        {
          "id": "FAULT",
          "description": "Collision or authentication fault state"
        }
      ],
      "transitions": [
        {
          "id": "F1",
          "from": "IDLE",
          "to": "COMPRESS",
          "event": "weight_valid",
          "guard": "weight_valid == 1 & cache_collision == 0",
          "priority": 1,
          "effectRefs": [
            "U1",
            "D1"
          ],
          "ruleIds": [
            "B1"
          ],
          "timingRef": "T1",
          "verificationRequired": true
        },
        {
          "id": "F2",
          "from": "COMPRESS",
          "to": "VERIFY",
          "event": "tag_valid",
          "guard": "tag_valid == 1",
          "priority": 1,
          "effectRefs": [
            "U2"
          ],
          "ruleIds": [],
          "timingRef": "T1",
          "verificationRequired": true
        },
        {
          "id": "F3",
          "from": "VERIFY",
          "to": "IDLE",
          "guard": "mac_error == 0",
          "priority": 1,
          "effectRefs": [],
          "ruleIds": [
            "B3"
          ],
          "timingRef": "T1",
          "verificationRequired": true
        },
        {
          "id": "F4",
          "from": "COMPRESS",
          "to": "FAULT",
          "event": "collision",
          "guard": "cache_collision == 1",
          "priority": 2,
          "effectRefs": [
            "U3"
          ],
          "ruleIds": [
            "B2"
          ],
          "timingRef": "T1",
          "verificationRequired": true
        },
        {
          "id": "F5",
          "from": "VERIFY",
          "to": "FAULT",
          "guard": "mac_error == 1",
          "priority": 2,
          "effectRefs": [
            "U3"
          ],
          "ruleIds": [
            "B2"
          ],
          "timingRef": "T1",
          "verificationRequired": true
        },
        {
          "id": "F6",
          "from": "FAULT",
          "to": "IDLE",
          "event": "reset_or_clear",
          "guard": "rst_n == 1 & cache_collision == 0",
          "priority": 1,
          "effectRefs": [
            "U4"
          ],
          "ruleIds": [],
          "timingRef": "T1",
          "verificationRequired": true
        }
      ]
    },
    "stateVariables": [
      {
        "id": "SV1",
        "name": "fifo_count",
        "width": 4,
        "signed": false,
        "reset": 0,
        "range": [
          0,
          8
        ],
        "updates": [
          {
            "id": "U1",
            "transitionIds": [
              "F1"
            ],
            "operation": "increment",
            "value": "fifo_count + 1"
          },
          {
            "id": "U4",
            "transitionIds": [
              "F6"
            ],
            "operation": "set",
            "value": 0
          }
        ]
      },
