  "publicTests": [
    {
      "id": "P01",
      "name": "Reset and ready state",
      "objective": "Confirm reset restores an idle UART and readable ready status.",
      "scenario": "Apply reset, then nonintrusively observe STATUS, tx and busy.",
      "expected": "STATUS.TX_READY=1, tx=1 and busy=0.",
      "status": "passed"
    },
    {
      "id": "P02",
      "name": "Firmware transmits ASCII A",
      "objective": "Trace the C driver polling STATUS and writing TXDATA through the real bridge.",
      "scenario": "Call firmware_send with one byte 0x41 and a sufficient poll limit.",
      "expected": "A TXDATA write occurs, busy asserts, an 8N1 frame for 0x41 appears, then STATUS.TX_READY returns to 1.",
      "status": "passed"
    },
    {
      "id": "P03",
      "name": "Zero polling budget",
      "objective": "Verify firmware obeys its timeout contract.",
      "scenario": "Call firmware_send for 0x40 with poll_limit=0.",
      "expected": "Firmware returns -1 without completing a frame.",
      "status": "passed"
    },
    {
      "id": "P04",
      "name": "Write while busy is ignored",
      "objective": "Verify the RTL does not start a second frame from a busy-state write.",
      "scenario": "Start 0x55 then issue a second TXDATA write while busy.",
      "expected": "Only the first frame is transmitted and the UART later returns ready.",
      "status": "passed"
    }
  ],
